# ==============================================================================
# DocuMind AI Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
MAX_UPLOAD_MB=25

# Document Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# MongoDB Atlas Vector Search Configuration
# Leave MONGODB_URI blank to run in deterministic In-Memory local development mode!
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DATABASE=documind_db
MONGODB_VECTOR_INDEX=vector_index

# Vector Retrieval Configuration
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# LLM Provider Configuration
# Options: mock, openai, groq, gemini, ollama
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE=
LLM_TIMEOUT=30

# Optical Character Recognition (OCR)
OCR_ENABLED=true
TESSERACT_CMD=
